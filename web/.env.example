# Web frontend — local development environment template.
# Copy to web/.env — real values stay local and ignored by git (.env* in .gitignore).
# No secrets here: this is configuration documentation, never credentials.

# Frontend-exposed variables must use the VITE_ convention: Vite embeds these
# into the built bundle at build time (they are public by nature).

# Base URL of the backend API the web app calls.
# Standalone web/backend dev: backend listens on http://127.0.0.1:4000 by default.
VITE_API_BASE_URL=http://127.0.0.1:4000

# Web dev-server port (vite). The Tauri desktop dev server overrides this to its
# own port (5174) via desktop/tauri.conf.json (beforeDevCommand => VITE_DEV_PORT=5174),
# so the web and desktop dev environments never collide.
VITE_DEV_PORT=5173