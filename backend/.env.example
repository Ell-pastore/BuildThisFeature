# Backend environment template (local development).
# Copy to backend/.env — real credentials must NEVER be committed (.env* is ignored).
# The backend loads this file automatically at startup via dotenv (src/index.ts).

# --- Database (used by the Prisma CLI and the runtime client) ----------------
# Example for a local Homebrew PostgreSQL (trust auth, your macOS username):
#   DATABASE_URL=postgresql://youruser@localhost:5432/smart_file_manager_dev
DATABASE_URL=postgresql://user:password@localhost:5432/smart_file_manager

# --- HTTP server -------------------------------------------------------------
# PORT:             HTTP port the API listens on (default 4000).
# HOST:             Bind address (default 127.0.0.1 — loopback only).
PORT=4000
HOST=127.0.0.1

# --- CORS --------------------------------------------------------------------
# Comma-separated browser/webview origins allowed to call the API.
# Defaults (when unset): the local Vite dev origins plus the Tauri webview
# origins (tauri://localhost, http://tauri.localhost).
# CORS_ORIGINS=http://localhost:5173

# --- Auth sessions -----------------------------------------------------------
# Session lifetime in hours (default 12).
# SESSION_TTL_HOURS=12

# --- Grok (xAI) provider -------------------------------------------------------
# Server-side AI provider used by the agent (Phase 10.9). API keys are real
# credentials: they must ONLY ever live in your local backend/.env (ignored),
# never in this template or anywhere in version control.
#
# GROK_API_KEY=                              # primary key (required to call xAI)
# GROK_API_KEY_1= GROK_API_KEY_2=            # optional extra keys (rotated through)
# GROK_MODEL=grok-3                          # model sent to xAI (default grok-3)
# GROK_BASE_URL=https://api.x.ai/v1          # xAI API base URL (default)
# GROK_TIMEOUT_MS=60000                      # request timeout in ms (default 60000)

# --- Gemini (Google AI) provider ------------------------------------------------
# Server-side AI provider used by the agent (Phase 10.14). API keys are real
# credentials: they must ONLY ever live in your local backend/.env (ignored).
#
# GEMINI_API_KEY=                            # primary key (required to call Gemini)
# GEMINI_API_KEY_1= GEMINI_API_KEY_2=        # optional extra keys (rotated through)
# GEMINI_MODEL=gemini-3.5-flash              # model sent to Gemini (default)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=60000                    # request timeout in ms (default 60000)

# --- OpenRouter provider ---------------------------------------------------------
# Server-side AI provider used by the agent (Phase 10.15). API keys are real
# credentials: they must ONLY ever live in your local backend/.env (ignored).
# There is NO default model: pick any slug from the OpenRouter catalog
# (e.g. anthropic/claude-sonnet-4, openai/gpt-5.2, ~openai/gpt-latest).
#
# OPENROUTER_API_KEY=                        # primary key (required to call OpenRouter)
# OPENROUTER_API_KEY_1= OPENROUTER_API_KEY_2= # optional extra keys (rotated through)
# OPENROUTER_MODEL=                          # REQUIRED — no default, e.g. anthropic/claude-sonnet-4
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=60000                # request timeout in ms (default 60000)

# --- Ollama (local) provider -------------------------------------------------------
# Server-side AI provider used by the agent (Phase 10.16). Local Ollama needs
# NO API key (the default http://localhost:11434/api endpoint is unauthenticated
# and is never routed through the credential pool as a secret). No model is
# assumed installed — pick one you have pulled locally.
#
# OLLAMA_MODEL=                              # REQUIRED — e.g. qwen3, llama3.2, gpt-oss:20b
# OLLAMA_BASE_URL=http://localhost:11434/api # local Ollama API base URL (default)
# OLLAMA_TIMEOUT_MS=60000                    # request timeout in ms (default 60000)

# --- AI provider composition (Phase 10.17) -----------------------------------
# Providers are configured once at the composition root (src/services/
# providerComposition.ts), which validates the chain and registers credentials
# into the pool before any request. Implemented provider ids:
#   grok, gemini, openrouter, ollama.
#
# AI_PROVIDER=grok                           # primary provider (default grok)
# AI_PROVIDER_FALLBACK=grok,gemini           # comma-separated fallback ORDER —
#   tried most-recent-failure-first, e.g. "gemini,ollama" tries gemini first.
#   Defaults to AI_PROVIDER alone when unset.
#
# Model/base-url/timeout are set per provider above. Grok/Gemini/OpenRouter in
# the chain REQUIRE at least one key (composition fails fast with a clear
# "missing-credentials" error otherwise). A provider with zero configured keys
# is skipped at runtime; a chain made up only of keyless providers fails fast.

# NOTE: No secrets belong in this template. Passwords, tokens and API keys are
# production concerns and must only ever live in the local backend/.env (ignored).